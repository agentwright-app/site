# Anthropic — https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: override the agent model (default claude-sonnet-5-5)
AGENT_MODEL=

# Postgres (Neon, Supabase, RDS or local)
DATABASE_URL=postgres://user:pass@localhost:5432/agentwright

# Auth.js — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Set to true in production behind a proxy (Vercel, Railway, Fly.io, a VPS); not needed for npm run dev
AUTH_TRUST_HOST=
# GitHub OAuth app — callback URL: {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional: magic-link email sign-in via Resend (https://resend.com/api-keys).
# Leave AUTH_RESEND_KEY empty to hide the email form on /login.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Agentwright <login@yourdomain.com>"

# Optional: MCP servers as tool sources (JSON; see lib/agent/mcp.ts)
# MCP_SERVERS='{"fs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}}'
MCP_SERVERS=

# Billing provider for the buttons on /pricing: lemonsqueezy (default) or polar.
# Fill in the block of the provider you use. Both webhook routes work whenever their
# secret is set, whatever this says.
BILLING_PROVIDER=

# Lemon Squeezy — webhook signing secret (Settings → Webhooks); see docs/setup.md, section 4
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
# Variant(s) that sell a one-time license key instead of a plan (comma-separated).
# order_created for these issues a key + delivery email; see docs/licensing.md
LEMONSQUEEZY_VARIANT_LICENSE=
# Hosted checkout links shown on /pricing (Products → Share → Checkout link)
NEXT_PUBLIC_LS_CHECKOUT_PRO=
NEXT_PUBLIC_LS_CHECKOUT_TEAM=
# Checkout link for a one-time license product (optional; shows a "Buy <LICENSE_PRODUCT_NAME>"
# card on /pricing; see docs/licensing.md)
NEXT_PUBLIC_LS_CHECKOUT_LICENSE=

# Polar — see docs/polar.md
# Organization access token (Settings → Access Tokens) with the scopes checkouts:write and
# customer_sessions:write. Used to open a checkout and the customer portal.
POLAR_ACCESS_TOKEN=
# Webhook signing secret (Settings → Webhooks → your endpoint)
POLAR_WEBHOOK_SECRET=
# production (default) or sandbox. A sandbox token only works with sandbox.
POLAR_SERVER=
# Product ids that sell each plan, comma-separated (monthly and yearly are two products).
# The name is POLAR_PRODUCT_ plus the plan id in upper case, so a plan "max" uses POLAR_PRODUCT_MAX.
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_TEAM=
# Product id(s) that sell a one-time license key instead of a plan (comma-separated).
# order.paid for these issues a key + delivery email; see docs/licensing.md
POLAR_PRODUCT_LICENSE=
# Checkout Link for the license product (Products → Checkout Links). Optional; shows the
# "Buy <LICENSE_PRODUCT_NAME>" card on /pricing
POLAR_CHECKOUT_LICENSE=
# Optional: your customer portal, https://polar.sh/<your-slug>/portal. "Manage billing"
# falls back to it when a one-click portal session cannot be created
POLAR_PORTAL_URL=
# Optional: Polar API version for the two API calls (default 2026-10). See docs/polar.md
POLAR_API_VERSION=

# ---------------------------------------------------------------------------
# License delivery (docs/licensing.md) — all optional
# ---------------------------------------------------------------------------
# Public URL of this app, used in delivery emails (defaults to http://localhost:3000)
APP_URL=
# Comma-separated emails allowed to open /admin/licenses
ADMIN_EMAILS=
# Transactional email via Resend (falls back to AUTH_RESEND_KEY; without either, emails are logged)
RESEND_API_KEY=
EMAIL_FROM="Agentwright <hello@yourdomain.com>"
SUPPORT_EMAIL=
# Private source repo buyers are invited to (owner/name) + a token with repo admin on it
LICENSE_GITHUB_REPO=
LICENSE_GITHUB_TOKEN=
# Where /api/download redirects (release zip, R2/S3 presigned URL). Unset → JSON stub.
LICENSE_DOWNLOAD_URL=
# Signs download links; defaults to AUTH_SECRET
LICENSE_TOKEN_SECRET=
# Product name in the delivery email and on the /pricing card
LICENSE_PRODUCT_NAME="My Product"
# Optional extra line at the end of the delivery email (e.g. where to start)
LICENSE_EMAIL_FOOTER=
